generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}



enum UserRole {
  passenger
  operator
  admin
}

enum SlotStatus {
  available
  held
  confirmed
  in_flight
  completed
  terminated
  cancelled
  expired
}

enum BookingType {
  now
  reserve
}

enum BookingStatus {
  held
  requested
  accepted
  declined
  expired
  cancelled_by_passenger
  cancelled_by_operator
  terminated_by_operator
  in_progress
  completed
  confirmed
  cancelled
}

enum BookingEventType {
  held_created
  requested
  accepted
  declined
  expired
  cancelled_by_passenger
  cancelled_by_operator
  cancellation_requested
  started
  completed
  terminated
  hold_expired
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         UserRole @default(passenger)
  createdAt    DateTime @default(now()) @map("created_at")

  operator Operator?
  bookings Booking[]
  auditEvents AuditEvent[] @relation("AuditActor")

  @@map("users")
}

model Operator {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user     User       @relation(fields: [userId], references: [id])
  aircraft Aircraft[]

  @@map("operators")
}

model Aircraft {
  id           String   @id @default(uuid())
  operatorId   String   @map("operator_id")
  model        String
  capacity     Int
  registration String   @unique
  createdAt    DateTime @default(now()) @map("created_at")

  operator Operator            @relation(fields: [operatorId], references: [id])
  slots    AvailabilitySlot[]

  @@map("aircraft")
}

model Helipad {
  id       String @id @default(uuid())
  name     String @unique
  city     String
  latitude Float
  longitude Float

  // PostGIS geography column - Prisma can't model this natively,
  // we write/query it via raw SQL in the matching engine.
  location Unsupported("geography(Point, 4326)")?

  slotsOrigin          AvailabilitySlot[] @relation("originHelipad")
  slotsDestination     AvailabilitySlot[] @relation("slotDestination")
  bookingsDestination Booking[]          @relation("destinationHelipad")

  @@map("helipads")
}

model AvailabilitySlot {
  id                    String     @id @default(uuid())
  aircraftId            String     @map("aircraft_id")
  helipadId             String     @map("helipad_id")
  destinationHelipadId  String?    @map("destination_helipad_id")
  startTime             DateTime   @map("start_time")
  endTime               DateTime   @map("end_time")
  status                SlotStatus @default(available)
  createdAt             DateTime   @default(now()) @map("created_at")

  aircraft           Aircraft @relation(fields: [aircraftId], references: [id])
  helipad            Helipad  @relation("originHelipad", fields: [helipadId], references: [id])
  destinationHelipad Helipad? @relation("slotDestination", fields: [destinationHelipadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookings           Booking[]

  @@index([helipadId, destinationHelipadId])
  @@map("availability_slots")
}

model Booking {
  id                   String        @id @default(uuid())
  userId               String        @map("user_id")
  slotId               String        @map("slot_id")
  destinationHelipadId String        @map("destination_helipad_id")
  bookingType          BookingType   @map("booking_type")
  status               BookingStatus @default(held)
  price                Decimal       @db.Decimal(10, 2)
  createdAt            DateTime      @default(now()) @map("created_at")
  reference            String        @unique @map("reference") @db.VarChar(20)

  requestedAt        DateTime? @map("requested_at")
  decisionDeadline   DateTime? @map("decision_deadline")
  acceptedAt         DateTime? @map("accepted_at")
  declinedAt         DateTime? @map("declined_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")

  user               User             @relation(fields: [userId], references: [id])
  slot               AvailabilitySlot @relation(fields: [slotId], references: [id])
  destinationHelipad Helipad          @relation("destinationHelipad", fields: [destinationHelipadId], references: [id])
  payment            Payment?
  events             BookingEvent[]

  @@index([userId, status])
  @@index([status, decisionDeadline])
  @@unique([slotId], where: raw("\"status\" IN ('held', 'requested', 'accepted', 'in_progress', 'confirmed')"), map: "bookings_active_slot_id_key")
  @@map("bookings")
}

model Payment {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  amount    Decimal  @db.Decimal(10, 2)
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  @@index([userId])
  @@map("sessions")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorRole  String   @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model BookingEvent {
  id         String            @id @default(uuid())
  bookingId  String            @map("booking_id")
  actorId    String?           @map("actor_id")
  actorRole  String            @map("actor_role")
  type       BookingEventType
  fromStatus BookingStatus?    @map("from_status")
  toStatus   BookingStatus?    @map("to_status")
  reason     String?
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}